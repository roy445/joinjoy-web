# City Explorer Planner
# AI provider: Gemini only. Never expose this key to the browser.
GEMINI_API_KEY=
# Optional four-slot rotation and monitoring. Keep keys server-side only.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.5-flash

# Obtain from Geoapify dashboard; keep the real value in local/deployment secrets.
GEOAPIFY_API_KEY=

# Foursquare Places API (real venue data, free tier, no credit card)
FOURSQUARE_API_KEY=

# Neon PostgreSQL connection string for Vercel.
DATABASE_URL=
# Bounded HTTP and PostgreSQL statement timeout (2s-30s, default 10s).
DB_QUERY_TIMEOUT_MS=10000

# Weather uses Open-Meteo (no API key required). Geoapify is optional for better place lookup.

# Support center SMTP notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ERROR_REPORT_TO=r03259468@gmail.com
